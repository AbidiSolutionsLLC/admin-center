{
  "name": "admin-center-server",
  "version": "1.0.0",
  "description": "Admin Center Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test-datafield-validation": "ts-node -T src/scripts/test-datafield-validation.ts",
    "test-datafield-api": "ts-node -T src/scripts/test-datafield-api.ts",
    "test-ip-restrictions": "ts-node -T src/scripts/test-ip-restrictions.ts",
    "seed:first": "ts-node -T src/scripts/seed-first-user.ts",
    "prestart": "npm run build",
    "test": "node --require ts-node/register/transpile-only --test \"src/**/__tests__/*.test.ts\""
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "nodemailer": "^8.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^8.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  }
}
