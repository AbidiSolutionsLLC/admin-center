{
  "name": "@karbexa/admin-api",
  "version": "1.0.0",
  "private": true,
  "description": "Karbexa Admin API: tenant admin API, OIDC identity provider (tenant/operator/services realms), operator API, platform API and event dispatcher",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test-datafield-validation": "ts-node -T src/scripts/test-datafield-validation.ts",
    "test-datafield-api": "ts-node -T src/scripts/test-datafield-api.ts",
    "test-ip-restrictions": "ts-node -T src/scripts/test-ip-restrictions.ts",
    "seed:operator": "ts-node -T src/scripts/seed-operator.ts",
    "seed:first": "ts-node -T src/scripts/seed-first-user.ts",
    "seed:products": "ts-node -T src/scripts/seed-products.ts",
    "seed:e11": "ts-node -T src/scripts/seed-e11.ts",
    "send:claims": "ts-node -T src/scripts/send-claim-emails.ts",
    "gen:admin-backend-key": "ts-node -T src/scripts/gen-admin-backend-key.ts",
    "prestart": "npm run build",
    "test": "node --require ts-node/register/transpile-only --test --test-concurrency=1 \"src/**/__tests__/*.test.ts\"",
    "migrate:identities": "ts-node -T src/scripts/migrate-identities.ts",
    "smoke:login": "ts-node -T src/scripts/smoke-oidc-login.ts",
    "smoke:sprint2": "ts-node -T src/scripts/smoke-sprint2.ts",
    "perf:lists": "ts-node -T src/scripts/perf-lists.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.17",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "nodemailer": "^10.5.0",
    "oidc-provider": "~9.13.3",
    "otplib": "^13.6.0",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "mongodb-memory-server": "^11.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
