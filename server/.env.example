# karbexa_admin/server — environment variables (names only; never commit real values)
PORT=5000
# development | production   (production enables strict CORS and secure cookies)
NODE_ENV=development
# Comma-separated list of allowed browser origins for /api/v1 (ADMIN_SPA_ORIGIN is always added)
CLIENT_URL=http://localhost:5173
# Development only: reflect ANY origin (never honoured in production)
ALLOW_ANY_ORIGIN=false
# Number of trusted reverse-proxy hops in front of the API (1 behind Azure App Service; 0 when exposed directly)
TRUST_PROXY=1

MONGODB_URI=
DB_NAME=admin_center

# Required by lib/cryptoService.ts (integration credentials + Identity TOTP secrets). 32+ random bytes.
ENCRYPTION_KEY=

# ── Identity service (E1, src/identity) ─────────────────────────────────────────────
# Issuer origin; tenant issuer = ${ID_ISSUER_ORIGIN}/realms/tenant, services = .../realms/services. https in production.
ID_ISSUER_ORIGIN=http://id.karbexa.localhost:5000
# SPA origins (OIDC redirect / post-logout URIs and CORS)
ADMIN_SPA_ORIGIN=http://admin.karbexa.localhost:5173
# Operator console SPA origin (same SPA as admin, route /operator)
OPERATOR_SPA_ORIGIN=http://admin.karbexa.localhost:5173
# Operator realm signing key (PEM / JWK / JWKS); dev generates server/.local/keys/operator.json
IDENTITY_OPERATOR_KEY=
PRODUCTS_SPA_ORIGIN=http://app.karbexa.localhost:5174
# oidc-provider cookie signing keys, comma-separated, newest first (required in production;
# dev fallback is generated into server/.local/cookie-keys.json)
OIDC_COOKIE_KEYS=
# Realm signing keys (required in production; dev keys are generated into server/.local/keys/<realm>.json).
# Value: PKCS#8 PEM (
 escapes allowed), a private RSA JWK, or a JWKS {"keys":[current, previous]}.
IDENTITY_TENANT_KEY=
IDENTITY_SERVICES_KEY=
# Microsoft Entra federation (platform multi-tenant app). Unset ENTRA_CLIENT_ID hides "Sign in with Microsoft".
# Redirect URI to register on the app: ${ID_ISSUER_ORIGIN}/realms/tenant/federation/entra/callback
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Public JWKS (JSON string or file path) of the karbexa-products-backend private_key_jwt client.
# Unset = client not registered in the services realm.
SERVICES_PRODUCTS_BACKEND_JWKS=

AZURE_COMMUNICATION_CONNECTION_STRING=
SENDER_EMAIL_ADDRESS=
EMAIL_FROM=
SENDGRID_API_KEY=

# Rate limits per IP per 15 minutes (defaults: global 10000 dev / 6000 prod; auth 100 dev / 20 prod)
GLOBAL_RATE_LIMIT=
AUTH_RATE_LIMIT=
# RBAC cache TTL in milliseconds (default 30000)
RBAC_CACHE_TTL_MS=

# Used only by `npm run seed:operator` (refused in production unless OPERATOR_SEED_FORCE=true)
OPERATOR_SEED_EMAIL=
OPERATOR_SEED_PASSWORD=
OPERATOR_SEED_NAME=

# Used only by `npm run seed:first`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
