# karbexa-admin/server: environment variables. Placeholders only; never commit real values.
# Every variable, its default and production notes: docs/CONFIGURATION.md. Production values, where each comes from
# (Key Vault or App Service setting) and the production must-haves: ../../docs/DEPLOYMENT.md (sections 2 and 5).
# Production examples are shown as `# prod:` lines.
PORT=5000
# development | production   (production enables strict CORS and secure cookies)
NODE_ENV=development
# Comma-separated list of allowed browser origins for /api/v1 (ADMIN_SPA_ORIGIN is always added). Invite links are built
# from the whole value, so in production keep it a single origin.
# prod: https://admin.<base-domain>
CLIENT_URL=http://localhost:5173
# Development only: reflect ANY origin (never honoured in production)
ALLOW_ANY_ORIGIN=false
# Trusted reverse proxies in front of the API: a hop count (1 behind Azure App Service), a comma-separated list of proxy IPs/CIDRs,
# or false/0 when exposed directly. REQUIRED in production (boot fails if unset; true is rejected). Development default: 1.
# Prefer the proxy CIDRs: a hop count trusts whatever X-Forwarded-For the previous hop supplied.
TRUST_PROXY=1
# prod: NODE_ENV=production and TRUST_PROXY=1 (Azure App Service is one proxy hop)

MONGODB_URI=
DB_NAME=admin_center
# Domain changes + audit + platform events commit in ONE Mongo transaction, which needs a replica set (a single-node rs0 is enough locally).
# Local development on a standalone mongod only: set true to run WITHOUT transactions (no atomicity). Ignored/refused in production.
ALLOW_STANDALONE_MONGO=false

# Required by lib/cryptoService.ts (integration credentials + Identity TOTP secrets). 32+ random bytes.
ENCRYPTION_KEY=

# ── Identity service (E1, src/identity) ─────────────────────────────────────────────
# Issuer origin; tenant issuer = ${ID_ISSUER_ORIGIN}/realms/tenant, services = .../realms/services. https in production.
# prod: https://id.<base-domain> (never changes: it is written into every token)
ID_ISSUER_ORIGIN=http://id.karbexa.localhost:5000
# SPA origins (OIDC redirect / post-logout URIs and CORS)
ADMIN_SPA_ORIGIN=http://admin.karbexa.localhost:5173
# Operator console SPA origin (same SPA as admin, route /operator)
OPERATOR_SPA_ORIGIN=http://admin.karbexa.localhost:5173
# Operator realm signing key (PEM / JWK / JWKS); dev generates server/.local/keys/operator.json
IDENTITY_OPERATOR_KEY=
PRODUCTS_SPA_ORIGIN=http://app.karbexa.localhost:5174
# oidc-provider cookie signing keys, comma-separated, newest first (required in production;
# dev fallback is generated into server/.local/cookie-keys.json)
OIDC_COOKIE_KEYS=
# Realm signing keys (required in production; dev keys are generated into server/.local/keys/<realm>.json).
# Value: PKCS#8 PEM (\n escapes allowed), a private RSA JWK, or a JWKS {"keys":[current, previous]}.
# Production: scripts/deploy/generate-secrets.ps1 creates all of them in Key Vault. Never reuse the dev keys.
IDENTITY_TENANT_KEY=
IDENTITY_SERVICES_KEY=
# Microsoft Entra federation (platform multi-tenant app). Unset ENTRA_CLIENT_ID hides "Sign in with Microsoft".
# Redirect URI to register on the app: ${ID_ISSUER_ORIGIN}/realms/tenant/federation/entra/callback
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Public JWKS (JSON string or file path) of the karbexa-products-backend private_key_jwt client.
# Unset = client not registered in the services realm.
SERVICES_PRODUCTS_BACKEND_JWKS=

# karbexa-admin-backend client (03 §2; audience urn:karbexa:products-internal, scope products.internal.read).
# `npm run gen:admin-backend-key` writes .local/keys/admin-backend.pem and prints both values.
# JWKS = public key (JSON string or file path); KEY = private PEM (inline or file path), used by productsInternalToken.ts.
# An inline PEM must contain real line breaks: unlike the identity keys and the products PLATFORM_CLIENT_KEY,
# \n escapes are NOT converted here.
SERVICES_ADMIN_BACKEND_JWKS=
ADMIN_BACKEND_CLIENT_KEY=

AZURE_COMMUNICATION_CONNECTION_STRING=
SENDER_EMAIL_ADDRESS=
EMAIL_FROM=

# Rate limits per IP per 15 minutes (defaults: global 10000 dev / 6000 prod; auth 100 dev / 20 prod)
GLOBAL_RATE_LIMIT=
AUTH_RATE_LIMIT=
# RBAC cache TTL in milliseconds (default 30000)
RBAC_CACHE_TTL_MS=

# Used only by `npm run seed:operator` (refused in production unless OPERATOR_SEED_FORCE=true)
OPERATOR_SEED_EMAIL=
OPERATOR_SEED_PASSWORD=
OPERATOR_SEED_NAME=

# Used only by `npm run seed:first` (not for go-live: use seed:operator and the organisation provisioning in the operator console).
# Always set SEED_ADMIN_PASSWORD to a strong value of your own: the code falls back to a known default when it is empty.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# prod: the staff egress IPs/CIDRs, for example 203.0.113.5,198.51.100.0/24 (compared with req.ip, so TRUST_PROXY must be right)
# Operator IP allow-list for /operator/v1 AND /realms/operator: comma-separated IPs/CIDRs (e.g. 203.0.113.5,10.0.0.0/8).
# Empty = allow all outside production; in production an empty list FAILS CLOSED (every operator request = 403).
OPERATOR_IP_ALLOWLIST=

# Local development only: include the one-time invite token in POST /operator/v1/orgs responses (the operator UI shows it).
# Honoured only when NODE_ENV is not production AND this is exactly true; never returned otherwise.
EXPOSE_INVITE_TOKEN=false

# ── Variables below were missing from this template (all optional; defaults are in the code) ──
# Full reference: docs/CONFIGURATION.md

# Seeding in production: seed:operator refuses NODE_ENV=production unless this is true
OPERATOR_SEED_FORCE=

# E-mail via SMTP (alternative to Azure Communication Services). Unset SMTP_HOST in development = ethereal test inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
# Local/test only: keep every e-mail in-process (printed, never sent). Ignored in production.
MOCK_EMAIL=false

# Links in policy notification e-mails (default http://localhost:5173)
APP_URL=http://admin.karbexa.localhost:5173

# Product launcher URLs. Default: PRODUCTS_SPA_ORIGIN + the product entry page (e.g. /people/home).
PEOPLE_LAUNCH_URL=
PROJECTS_LAUNCH_URL=
SIGN_LAUNCH_URL=
DESK_LAUNCH_URL=

# Platform events to the products backend
# JSON [{"name":"karbexa-products-backend","url":"<products-api>/api/v1/internal/platform-events","secret_env":"PLATFORM_SUB_SECRET_PRODUCTS"}]
PLATFORM_SUBSCRIPTIONS=
# HMAC secret named by secret_env above; must equal the products backend PLATFORM_NUDGE_SECRET
PLATFORM_SUB_SECRET_PRODUCTS=
# off = disable the nudge dispatcher; tick interval in ms (default 2000)
PLATFORM_DISPATCHER=
PLATFORM_DISPATCH_INTERVAL_MS=
# Per service client requests/minute on /platform/v1 (default 1200; counted in MongoDB, shared by all instances)
PLATFORM_RATE_LIMIT_PER_MIN=
# JSON {"<clientId>":["people",...]}: products each service client may write role catalogs for
PLATFORM_CLIENT_PRODUCTS=
# Products backend base URL for open-items lookups (default: origin of the PLATFORM_SUBSCRIPTIONS entry)
PRODUCTS_INTERNAL_URL=

# Audit SSE stream: session re-check interval in ms (default 30000)
STREAM_RECHECK_MS=

# Date (ISO, for example 2027-11-18) by which the signing keys should be replaced. Within 7 days of it (or after it) the
# Command Center platform health shows the identity component as degraded. Unset = no rotation warning.
IDENTITY_KEY_ROTATE_BY=
