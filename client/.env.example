# karbexa-admin/client: build-time variables (Vite bakes them into the bundle; there is no runtime configuration).
# Placeholders only. Production values and the build: ../../docs/DEPLOYMENT.md (sections 2 and 4).
# prod: VITE_API_URL=https://admin-api.<base-domain>/api/v1
# prod: VITE_OIDC_ISSUER=https://id.<base-domain>/realms/tenant        (must equal ID_ISSUER_ORIGIN + /realms/tenant)
# prod: VITE_ID_ISSUER_ORIGIN=https://id.<base-domain>                  (must equal ID_ISSUER_ORIGIN)
# prod: VITE_OPERATOR_API_URL=https://admin-api.<base-domain>/operator/v1
# prod: VITE_OIDC_CLIENT_ID=karbexa-admin-spa (unchanged)
VITE_API_URL=http://admin.karbexa.localhost:5000/api/v1
VITE_OIDC_ISSUER=http://id.karbexa.localhost:5000/realms/tenant
VITE_OIDC_CLIENT_ID=karbexa-admin-spa
# Operator realm (E10): authority = ${VITE_ID_ISSUER_ORIGIN}/realms/operator; operator API base
VITE_ID_ISSUER_ORIGIN=http://id.karbexa.localhost:5000
VITE_OPERATOR_API_URL=http://admin.karbexa.localhost:5000/operator/v1
